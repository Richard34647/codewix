{
  "name": "codewix-desktop",
  "version": "1.0.0",
  "description": "CodeWix - Learn to code, build projects, publish them live.",
  "author": "Richard Wilcox",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "@emailjs/nodejs": "^5.0.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^11.11.0",
    "groq-sdk": "^1.6.0",
    "msedge-tts": "^2.1.0",
    "openai": "^7.36.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.codewix.app",
    "productName": "CodeWix",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "publisherName": "Richard Wilcox"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}